# BloxPass - Roblox-Discord Verification Bot Configuration
# Copy this file to .env and fill in your values

# ========== GLOBAL DISCORD BOT SETTINGS ==========
# These are the ONLY settings needed in .env for a PUBLIC bot
# Get these from: https://discord.com/developers/applications
DISCORD_TOKEN=your_discord_bot_token_here
DISCORD_CLIENT_ID=your_discord_application_id_here

# ========== BLOXLINK API SETTINGS ==========
# Get API key from: https://blox.link/
# ONE key works for ALL servers your bot is in
BLOXLINK_API_KEY=your_bloxlink_api_key_here

# Optional: Custom Bloxlink API endpoint (default: https://api.blox.link)
# Use this if you're self-hosting Bloxlink or using a proxy
BLOXLINK_API_BASE=https://api.blox.link

# ========== PER-SERVER SETTINGS ==========
# These are NOT set here - each Discord server configures their own
# via the /setup command. Settings are stored in the SQLite database.
# Each server has its own:
# - DISCORD_GUILD_ID (automatically detected)
# - VERIFIED_ROLE_ID
# - MODERATION_ROLE_ID
# - ADMIN_ROLE_ID
# - UNVERIFIED_ROLE_ID
